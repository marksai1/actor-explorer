# Required. Your TMDB API key (v3 auth, the short one — not the long v4 bearer token).
# Find it at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Letterboxd username (just the handle, e.g. "marks" from letterboxd.com/marks).
# Films sync automatically from your public RSS feed — no login needed.
LETTERBOXD_USER=

# Your IMDb user id, the "ur" number — shows sync from your public watch history,
# no login needed. Pasting the whole profile URL works too.
#
# To find it: sign in to IMDb, open imdb.com/profile, and look for a "ur…" number.
# Then, in Account Settings → Privacy, set BOTH of these to public:
#   Watch history  — this is what makes the sync work at all
#   Ratings        — optional, but it adds your scores and dates, which ranking uses
IMDB_USER_ID=

# Optional. Port for the local server.
PORT=8787

# Optional. Listening address. The default accepts connections from the rest of
# your network, which is what lets a phone open the app — there's no login in
# front of it, so use 127.0.0.1 to keep it to this machine only.
HOST=0.0.0.0
