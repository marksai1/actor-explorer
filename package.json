{
  "name": "actor-explorer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Find out where you know an actor from, filtered to only what you've actually watched.",
  "engines": {
    "//": "node:sqlite needs --experimental-sqlite before 22.13/23.4, so that is the real floor.",
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "vite build --config client/vite.config.ts",
    "build:static": "vite build --config client/vite.static.config.ts",
    "preview:static": "vite preview --config client/vite.static.config.ts",
    "icons": "node client/scripts/make-icons.mjs",
    "start": "tsx server/index.ts",
    "login": "tsx server/scripts/login.ts",
    "sync": "tsx server/scripts/sync.ts",
    "snapshot": "tsx server/scripts/snapshot.ts",
    "reindex": "tsx server/scripts/reindex.ts",
    "verify": "tsx server/scripts/verify.ts",
    "doctor": "tsx server/scripts/doctor.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p client/tsconfig.json"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.1.1",
    "dotenv": "^16.4.7",
    "fast-xml-parser": "^4.5.1",
    "fastify": "^5.2.1",
    "fflate": "^0.8.2",
    "playwright": "^1.50.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
